# Set to "static" to run standalone against the JSON fixtures in public/demo-data/
# (no backend needed - see the root README's "Frontend" section). Leave unset (or "api")
# for the default live mode, which talks to the Spring Boot backend below.
VITE_DATA_MODE=api

# Base URL of the Spring Boot backend. Only used when VITE_DATA_MODE=api (or unset).
VITE_API_BASE_URL=http://localhost:8083
